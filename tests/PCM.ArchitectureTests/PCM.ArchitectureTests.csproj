<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Architecture rules as tests: layer dependencies, thin controllers, repositories that never save,
    and cached endpoints that are public. A pull request that breaks a rule fails CI.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- PCM.API brings Infrastructure, Repositories and DomainEntities with it. -->
    <ProjectReference Include="..\..\PCM.API\PCM.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
