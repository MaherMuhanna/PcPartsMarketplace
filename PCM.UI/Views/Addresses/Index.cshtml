@model AddressListViewModel
@{
    ViewData["Title"] = "My addresses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My addresses</h1>
    <a class="btn btn-primary" asp-action="Create">Add address</a>
</div>

@if (Model.Addresses.Count == 0)
{
    <div class="alert alert-info">You have no saved addresses yet. Add one to use it at checkout.</div>
}
else
{
    <div class="row g-3">
        @foreach (var address in Model.Addresses)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(address.IsDefault ? "border-primary" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h2 class="h6 mb-1">@address.City</h2>
                            @if (address.IsDefault)
                            {
                                <span class="badge text-bg-primary">Default</span>
                            }
                        </div>
                        <p class="mb-1">@address.Street</p>
                        @if (!string.IsNullOrEmpty(address.Details))
                        {
                            <p class="text-muted small mb-1">@address.Details</p>
                        }
                        <p class="text-muted small mb-0">@address.Phone</p>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@address.Id">Edit</a>
                        @if (!address.IsDefault)
                        {
                            <form asp-action="SetDefault" asp-route-id="@address.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Make default</button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@address.Id" method="post" class="ms-auto"
                              onsubmit="return confirm('Delete this address?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
