@model LoginViewModel
@inject PCM.UI.Demo.DemoAccounts DemoAccounts
@{
    ViewData["Title"] = "Sign in";
}

<div class="card auth-card mx-auto shadow-sm">
    <div class="card-body p-4">
        <h1 class="h4 mb-3">Sign in</h1>

        <form asp-action="Login" method="post" novalidate>
            <partial name="_FormErrors" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>

        <p class="text-muted small mt-3 mb-0">
            No account yet? <a asp-action="Register">Create one</a>
        </p>
    </div>
</div>

@if (DemoAccounts.IsEnabled)
{
    @* Development only (see DemoAccounts): lets a reviewer try every role without typing. *@
    <div class="card auth-card mx-auto mt-3 border-info" id="demoAccounts" data-password="@DemoAccounts.Password">
        <div class="card-body p-3">
            <h2 class="h6 mb-1">Demo accounts</h2>
            <p class="text-muted small mb-2">Click one to fill the form. Password for all: <code>@DemoAccounts.Password</code></p>
            <div class="list-group list-group-flush small">
                @foreach (var account in DemoAccounts.List)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center demo-account" data-email="@account.Email">
                        <span><span class="badge text-bg-secondary me-2">@account.Role</span>@account.Email</span>
                        <span class="text-muted">@account.Note</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.demo-account').forEach(button => button.addEventListener('click', () => {
            document.getElementById('Email').value = button.dataset.email;
            document.getElementById('Password').value = document.getElementById('demoAccounts').dataset.password;
            document.querySelector('form button[type=submit]').focus();
        }));
    </script>
}
