@model AttributeFieldsModel
@* Fields of the add (Attribute = null) and edit attribute forms. Text attributes cannot be filters: the
   checkbox is disabled for them (the API enforces the same rule). *@
@{
    var spec = Model.Attribute;
    var prefix = spec is null ? "new" : $"a{spec.Id}";
    var dataType = spec?.DataType ?? "Enum";
}
<div class="row g-2">
    <div class="col-md-4">
        <label class="form-label small mb-1" for="@(prefix)Name">Name</label>
        <input id="@(prefix)Name" name="Name" value="@spec?.Name" class="form-control form-control-sm" maxlength="100" required />
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1" for="@(prefix)Type">Type</label>
        <select id="@(prefix)Type" name="DataType" class="form-select form-select-sm" data-attr-type>
            @foreach (var type in AdminCategoriesViewModel.DataTypes)
            {
                <option value="@type" selected="@(type == dataType)">@type</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1" for="@(prefix)Unit">Unit <span class="text-muted">(optional)</span></label>
        <input id="@(prefix)Unit" name="Unit" value="@spec?.Unit" class="form-control form-control-sm" maxlength="20" placeholder="GB, MHz, W" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1" for="@(prefix)Sort">Order</label>
        <input id="@(prefix)Sort" name="SortOrder" type="number" value="@(spec?.SortOrder ?? 0)" class="form-control form-control-sm" min="0" max="10000" />
    </div>
    <div class="col-12 d-flex flex-wrap gap-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="@(prefix)Filterable" name="IsFilterable" value="true" checked="@(spec?.IsFilterable ?? false)" data-attr-filterable />
            <input type="hidden" name="IsFilterable" value="false" />
            <label class="form-check-label small" for="@(prefix)Filterable">Catalog filter</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="@(prefix)Required" name="IsRequired" value="true" checked="@(spec?.IsRequired ?? false)" />
            <input type="hidden" name="IsRequired" value="false" />
            <label class="form-check-label small" for="@(prefix)Required">Required on every product</label>
        </div>
    </div>
</div>
