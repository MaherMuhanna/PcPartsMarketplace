@model OfferProductPickerViewModel
@{
    ViewData["Title"] = "Add offer";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">My offers</a></li>
        <li class="breadcrumb-item active" aria-current="page">Add offer</li>
    </ol>
</nav>

<h1 class="h3">Add offer</h1>
<p class="text-muted">Step 1 of 2: find the product in the catalog. You can also open any product page and press <strong>Sell this</strong>.</p>

<form asp-action="Create" method="get" class="d-flex gap-2 mb-4 picker-search" role="search">
    <input type="search" name="q" value="@Model.Q" class="form-control" maxlength="100" placeholder="Product name or model number" aria-label="Search products" autofocus />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

@if (Model.Results is { } results)
{
    if (results.Items.Count == 0)
    {
        <div class="alert alert-light border">
            No catalog product matches "@Model.Q". If it is missing from the catalog, <a class="alert-link" asp-controller="SellerProposals" asp-action="Create">propose it as a new product</a> (admin review).
        </div>
    }
    else
    {
        <p class="text-muted small">
            @results.TotalCount product(s) found@(results.TotalCount > results.Items.Count ? $", showing the first {results.Items.Count}. Refine the search to narrow it down" : "").
        </p>
        <div class="list-group">
            @foreach (var product in results.Items)
            {
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-3"
                   asp-action="Create" asp-route-productId="@product.Id">
                    <img src="@(product.MainImageUrl ?? DisplayExtensions.PlaceholderImage)" alt="" class="offer-thumb border rounded" />
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@product.Name</div>
                        <div class="text-muted small">@product.Brand.Name &middot; @product.Category.Name &middot; <span class="font-monospace">@product.ModelNumber</span></div>
                    </div>
                    <div class="text-end small text-nowrap">
                        @if (product.MinPrice is { } minPrice)
                        {
                            <div>From @minPrice.ToPrice()</div>
                        }
                        <div class="text-muted">@product.OfferCount offer(s)</div>
                    </div>
                </a>
            }
        </div>
    }
}
