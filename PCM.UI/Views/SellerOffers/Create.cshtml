@model OfferCreateViewModel
@{
    ViewData["Title"] = "Add offer";
    var product = Model.Product!;
    var image = product.Images.Count > 0 ? product.Images[0].Url : DisplayExtensions.PlaceholderImage;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">My offers</a></li>
        <li class="breadcrumb-item"><a asp-action="Create">Add offer</a></li>
        <li class="breadcrumb-item active" aria-current="page">@product.Name</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex gap-3 align-items-center mb-3">
                    <img src="@image" alt="" class="offer-thumb-lg border rounded" />
                    <div>
                        <div class="small text-muted">@product.Brand.Name</div>
                        <h1 class="h5 mb-1">@product.Name</h1>
                        <div class="small text-muted font-monospace">@product.ModelNumber</div>
                    </div>
                </div>

                @* What the competition charges helps the seller price the offer. *@
                <h2 class="h6">Current offers</h2>
                @if (product.Offers.Count == 0)
                {
                    <p class="text-muted small mb-0">Nobody sells this product yet.</p>
                }
                else
                {
                    <table class="table table-sm small mb-0">
                        <tbody>
                            @foreach (var offer in product.Offers)
                            {
                                <tr>
                                    <td>@offer.StoreName</td>
                                    <td>@offer.Condition</td>
                                    <td class="text-end">@offer.Price.ToPrice()</td>
                                    <td class="text-end text-muted">@(offer.Available > 0 ? $"{offer.Available} left" : "Out of stock")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h5 mb-1">Your offer</h2>
                <p class="text-muted small">Step 2 of 2. One offer per product and condition.</p>

                <form asp-action="Create" method="post" novalidate>
                    <partial name="_FormErrors" />
                    <input type="hidden" asp-for="ProductId" />

                    <fieldset class="mb-3">
                        <legend class="form-label fs-6">Condition</legend>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Condition" id="conditionNew" value="New" />
                            <label class="form-check-label" for="conditionNew">New</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Condition" id="conditionUsed" value="Used" />
                            <label class="form-check-label" for="conditionUsed">Used</label>
                        </div>
                        <span asp-validation-for="Condition" class="text-danger small d-block"></span>
                    </fieldset>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label asp-for="Price" class="form-label"></label>
                            @* Own −/+ buttons instead of the browser spinner: they move the price by exactly 1 JOD and keep the cents
                               (9.75 -> 10.75). See data-price-input in wwwroot/js/site.js. The API still enforces 0.01 to 999,999.99, 2 decimals. *@
                            <div class="input-group">
                                <button type="button" class="btn btn-outline-secondary" data-step-by="-1" aria-label="Decrease price by 1">&minus;</button>
                                <input asp-for="Price" class="form-control text-end" type="text" inputmode="decimal" autocomplete="off" data-price-input data-min="0.01" data-max="999999.99" value="@(Model.Price > 0 ? Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                <button type="button" class="btn btn-outline-secondary" data-step-by="1" aria-label="Increase price by 1">+</button>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Stock" class="form-label"></label>
                            <input asp-for="Stock" class="form-control" type="number" step="1" min="0" max="100000" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="LowStockThreshold" class="form-label"></label>
                            <input asp-for="LowStockThreshold" class="form-control" type="number" step="1" min="0" max="1000" />
                            <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
                        </div>
                    </div>
                    <p class="form-text">Initial stock is recorded in the offer's history as a restock. Later changes use the <strong>Stock</strong> button.</p>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Add offer</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
