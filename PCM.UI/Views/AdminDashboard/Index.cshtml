@using PCM.Infrastructure.DTO.Dashboards
@model AdminDashboardDto
@{
    ViewData["Title"] = "Admin dashboard";
    var s = Model.SubOrdersByStatus;
    (string Status, int Count, string Hint)[] statuses =
    [
        ("Pending", s.Pending, "waiting for the seller"),
        ("Confirmed", s.Confirmed, "to be shipped"),
        ("Shipped", s.Shipped, "on the way"),
        ("Delivered", s.Delivered, "cash collected"),
        ("Cancelled", s.Cancelled, "stock released")
    ];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Admin dashboard</h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm btn-primary" asp-controller="AdminProducts" asp-action="Create">Add product</a>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="AdminCategories" asp-action="Index">Categories and specs</a>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="AdminBrands" asp-action="Index">Brands</a>
    </div>
</div>

<h2 class="h6 text-uppercase text-muted mb-2">Waiting for review</h2>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel("Seller sign-ups", Model.PendingSellers.ToString(),
            Url.Action("Index", "AdminSellers", new { status = "Pending" }), "approve or reject", Model.PendingSellers > 0))" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel("Product proposals", Model.PendingProposals.ToString(),
            Url.Action("Index", "AdminProducts", new { status = "Pending" }), "from sellers", Model.PendingProposals > 0))" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel("Orders, last 7 days", Model.OrdersLast7Days.ToString(),
            Url.Action("Index", "AdminOrders"), "customer checkouts"))" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel("Delivered sales, last 30 days", Model.DeliveredSalesLast30Days.ToPrice(),
            Url.Action("Index", "AdminOrders", new { status = "Delivered" }), "cash on delivery", ValueCss: "text-success"))" />
    </div>
</div>

<h2 class="h6 text-uppercase text-muted mb-2">Shipments by status</h2>
<p class="small text-muted">Each order is split into one shipment per seller, so shipments are counted, not orders.</p>
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
    @foreach (var (status, count, hint) in statuses)
    {
        <div class="col">
            <partial name="_StatCard" model="@(new StatCardViewModel(status, count.ToString(),
                Url.Action("Index", "AdminOrders", new { status }), hint))" />
        </div>
    }
</div>
