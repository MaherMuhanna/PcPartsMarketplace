@using PCM.Infrastructure.DTO.Carts
@model CartDto
@{
    ViewData["Title"] = "Your cart";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Your cart</h1>
    @if (Model.ItemCount > 0)
    {
        <form asp-action="Clear" method="post" onsubmit="return confirm('Remove every item from your cart?');">
            <button type="submit" class="btn btn-sm btn-outline-danger">Empty cart</button>
        </form>
    }
</div>

@if (Model.ItemCount == 0)
{
    <div class="alert alert-info">
        Your cart is empty. <a class="alert-link" asp-controller="Catalog" asp-action="Index">Browse the catalog</a> and add parts from any seller.
    </div>
    return;
}

<div class="row g-4">
    <div class="col-lg-8">
        @* One card per seller: each becomes its own shipment (sub-order) at checkout. *@
        @foreach (var seller in Model.Sellers)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between">
                    <span>Sold by <strong>@seller.StoreName</strong></span>
                    <span class="text-muted small">Subtotal @seller.Subtotal.ToPrice()</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in seller.Items)
                    {
                        <li class="list-group-item @(item.Issue is null ? "" : "list-group-item-warning")">
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <img src="@(item.ImageUrl ?? DisplayExtensions.PlaceholderImage)" alt="" class="offer-thumb border rounded bg-white" />
                                <div class="flex-grow-1">
                                    <a asp-controller="Products" asp-action="Details" asp-route-slug="@item.ProductSlug" class="fw-semibold text-decoration-none">@item.ProductName</a>
                                    <div class="small text-muted">
                                        <span class="badge @(item.Condition == "New" ? "text-bg-primary" : "text-bg-secondary")">@item.Condition</span>
                                        @item.UnitPrice.ToPrice() each
                                        @if (item.Issue is null)
                                        {
                                            <span>&middot; @item.Available available</span>
                                        }
                                    </div>
                                    @if (item.Issue == CartIssues.Unavailable)
                                    {
                                        <div class="small text-danger mt-1">This offer is no longer available. Remove it to check out.</div>
                                    }
                                    else if (item.Issue == CartIssues.InsufficientStock)
                                    {
                                        <div class="small text-danger mt-1">
                                            @(item.Available == 0 ? "Out of stock." : $"Only {item.Available} available. Lower the quantity to check out.")
                                        </div>
                                    }
                                </div>

                                @if (item.Issue != CartIssues.Unavailable)
                                {
                                    @* Quantity 1 to 10, never above what is available (the API checks again). *@
                                    <form asp-action="UpdateQuantity" asp-route-id="@item.Id" method="post" class="d-flex align-items-center gap-1">
                                        <label class="visually-hidden" for="qty-@item.Id">Quantity</label>
                                        <input type="number" id="qty-@item.Id" name="quantity" value="@item.Quantity" min="1"
                                               max="@Math.Max(1, Math.Min(10, item.Available))" class="form-control form-control-sm cart-qty" required />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                                    </form>
                                }

                                <div class="text-end cart-line-total fw-semibold">@item.LineTotal.ToPrice()</div>

                                <form asp-action="Remove" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-link text-danger" aria-label="Remove @item.ProductName">Remove</button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Summary</h2>
                <dl class="row mb-2">
                    <dt class="col-7 fw-normal">Items</dt>
                    <dd class="col-5 text-end">@Model.ItemCount</dd>
                    <dt class="col-7 fw-normal">Shipments</dt>
                    <dd class="col-5 text-end">@Model.Sellers.Count</dd>
                    <dt class="col-7 fw-normal">Shipping</dt>
                    <dd class="col-5 text-end">Free</dd>
                    <dt class="col-7">Total</dt>
                    <dd class="col-5 text-end fw-semibold">@Model.Total.ToPrice()</dd>
                </dl>
                <p class="small text-muted">Payment: cash on delivery.</p>

                @if (Model.CanCheckout)
                {
                    <a class="btn btn-primary w-100" asp-controller="Checkout" asp-action="Index">Proceed to checkout</a>
                }
                else
                {
                    <button type="button" class="btn btn-primary w-100" disabled>Proceed to checkout</button>
                    <p class="small text-danger mt-2 mb-0">Fix or remove the highlighted items first.</p>
                }
            </div>
        </div>
    </div>
</div>
