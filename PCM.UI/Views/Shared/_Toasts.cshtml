@* One flash-message style for the whole site: a toast in the top-right corner.
   Controllers set TempData["Success"] or TempData["Error"] before a redirect.
   Success hides itself after a few seconds; errors stay until closed. site.js shows them. *@
@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
@if (success is not null || error is not null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3 site-toasts">
        @if (error is not null)
        {
            <div class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="false">
                <div class="d-flex">
                    <div class="toast-body">@error</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (success is not null)
        {
            <div class="toast align-items-center text-bg-success border-0" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="5000">
                <div class="d-flex">
                    <div class="toast-body">@success</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>
}
