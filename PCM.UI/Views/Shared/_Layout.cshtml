@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var sellerStatus = User.FindFirstValue(AppClaimTypes.SellerStatus);
    var isApprovedSeller = sellerStatus == "Approved";

    // Controllers behind each dropdown, so the dropdown itself is highlighted on its pages.
    string[] adminControllers = ["AdminDashboard", "AdminSellers", "AdminOrders", "AdminCategories", "AdminBrands", "AdminProducts"];
    string[] sellerControllers = ["SellerDashboard", "SellerOrders", "SellerOffers", "SellerProposals", "Store"];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PC Parts Marketplace</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">PC Parts Marketplace</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @ViewContext.ActiveIf("Catalog", "Products")" aria-current="@ViewContext.AriaCurrent("Catalog", "Products")"
                               asp-controller="Catalog" asp-action="Index">Catalog</a>
                        </li>
                    </ul>
                    <form asp-controller="Catalog" asp-action="Index" method="get" class="d-flex my-2 my-lg-0 nav-search" role="search">
                        <input type="search" name="q" class="form-control form-control-sm" placeholder="Search parts" aria-label="Search products" maxlength="100" value="@Context.Request.Query["q"]" />
                    </form>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (isSignedIn)
                        {
                            @if (User.IsInRole(Roles.Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @ViewContext.ActiveIf(adminControllers)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("AdminDashboard")" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><h6 class="dropdown-header">Marketplace</h6></li>
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("AdminOrders")" asp-controller="AdminOrders" asp-action="Index">Orders</a></li>
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("AdminSellers")" asp-controller="AdminSellers" asp-action="Index">Sellers</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><h6 class="dropdown-header">Catalog</h6></li>
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("AdminProducts")" asp-controller="AdminProducts" asp-action="Index">Products</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminProducts" asp-action="Index" asp-route-status="Pending">Review queue</a></li>
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("AdminCategories")" asp-controller="AdminCategories" asp-action="Index">Categories and specs</a></li>
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("AdminBrands")" asp-controller="AdminBrands" asp-action="Index">Brands</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole(Roles.Seller))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @ViewContext.ActiveIf(sellerControllers)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Seller</a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("SellerDashboard")" asp-controller="SellerDashboard" asp-action="Index">Dashboard</a></li>
                                        @* A suspended seller cannot sell, but still finishes the orders they accepted. *@
                                        @if (sellerStatus is "Approved" or "Suspended")
                                        {
                                            <li><a class="dropdown-item @ViewContext.ActiveIf("SellerOrders")" asp-controller="SellerOrders" asp-action="Index">Orders</a></li>
                                        }
                                        @if (isApprovedSeller)
                                        {
                                            <li><a class="dropdown-item @ViewContext.ActiveIf("SellerOffers")" asp-controller="SellerOffers" asp-action="Index">My offers</a></li>
                                            <li><a class="dropdown-item @ViewContext.ActiveIf("SellerProposals")" asp-controller="SellerProposals" asp-action="Index">Product proposals</a></li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item @ViewContext.ActiveIf("Store")" asp-controller="Store" asp-action="Index">My store</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole(Roles.Customer))
                            {
                                <li class="nav-item"><a class="nav-link @ViewContext.ActiveIf("Orders")" aria-current="@ViewContext.AriaCurrent("Orders")" asp-controller="Orders" asp-action="Index">My orders</a></li>
                                <li class="nav-item"><a class="nav-link @ViewContext.ActiveIf("Addresses")" aria-current="@ViewContext.AriaCurrent("Addresses")" asp-controller="Addresses" asp-action="Index">My addresses</a></li>
                                @await Component.InvokeAsync("CartBadge")
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity!.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-muted">@User.FindFirstValue(AppClaimTypes.Email)</span></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @ViewContext.ActiveIf("Account")" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-outline-light btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Create account</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @if (User.IsInRole(Roles.Seller) && sellerStatus is not null && !isApprovedSeller && !ViewContext.IsController("SellerDashboard", "Store"))
        {
            <partial name="_SellerStatusBanner" model="sellerStatus" />
        }

        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container">PC Parts Marketplace &middot; portfolio project</div>
    </footer>

    <partial name="_Toasts" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
