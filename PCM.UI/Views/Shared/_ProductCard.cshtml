@model ProductListItemDto
@* One product tile, used by the catalog grid and the home page. *@
<div class="card h-100 product-card shadow-sm">
    <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="product-card-image">
        <img src="@(Model.MainImageUrl ?? DisplayExtensions.PlaceholderImage)" alt="@Model.Name" loading="lazy" />
    </a>
    <div class="card-body d-flex flex-column">
        <div class="small text-muted mb-1">@Model.Brand.Name &middot; @Model.Category.Name</div>
        <h2 class="h6 card-title mb-1">
            <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="stretched-link text-reset text-decoration-none">@Model.Name</a>
        </h2>
        <div class="small text-muted text-truncate mb-2" title="@Model.ModelNumber">@Model.ModelNumber</div>
        <div class="mt-auto">
            @if (Model.MinPrice is { } price)
            {
                <div class="fw-semibold">From @price.ToPrice()</div>
                <div class="small text-success">@Model.OfferCount offer(s)</div>
            }
            else if (Model.OfferCount > 0)
            {
                <div class="small text-danger">Out of stock</div>
            }
            else
            {
                <div class="small text-muted">No offers yet</div>
            }
        </div>
    </div>
</div>
