@model PagerViewModel
@* Shared pagination: keeps the list's filters in every link and collapses long ranges with "...". *@
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pages">
        <ul class="pagination pagination-sm flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.For(Math.Max(Model.Page - 1, 1))" aria-label="Previous">&laquo;</a>
            </li>
            @foreach (var p in Model.Pages())
            {
                if (p == 0)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.For(p)" aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                    </li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.For(Math.Min(Model.Page + 1, Model.TotalPages))" aria-label="Next">&raquo;</a>
            </li>
        </ul>
    </nav>
}
