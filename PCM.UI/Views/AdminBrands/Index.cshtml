@model AdminBrandsViewModel
@{
    ViewData["Title"] = "Brands";
    var brands = Model.Brands;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Brands</h1>
    <span class="text-muted small">@brands.TotalCount brand(s)</span>
</div>

<div class="row g-4">
    <div class="col-lg-4 order-lg-2">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Add a brand</h2>
                <form asp-action="Create" method="post">
                    <div class="mb-2">
                        <label for="newName" class="form-label small mb-1">Name</label>
                        <input id="newName" name="name" class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label for="newLogo" class="form-label small mb-1">Logo URL <span class="text-muted">(optional, http or https)</span></label>
                        <input id="newLogo" name="logoUrl" type="url" class="form-control" maxlength="500" placeholder="https://..." />
                    </div>
                    <button type="submit" class="btn btn-primary">Add brand</button>
                </form>
                <p class="form-text mb-0 mt-2">The filter key (slug) is made from the name, e.g. "Western Digital" becomes <code>western-digital</code>.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-8 order-lg-1">
        @if (brands.Items.Count == 0)
        {
            <div class="alert alert-info">No brands yet.</div>
        }
        else
        {
            <div class="list-group">
                @foreach (var brand in brands.Items)
                {
                    var editId = $"brandEdit{brand.Id}";
                    <div class="list-group-item">
                        <div class="d-flex align-items-center gap-3">
                            @if (brand.LogoUrl is not null)
                            {
                                <img src="@brand.LogoUrl" alt="" class="brand-logo border rounded" loading="lazy" />
                            }
                            else
                            {
                                <span class="brand-logo border rounded d-inline-flex align-items-center justify-content-center text-muted small">@(brand.Name[..1])</span>
                            }
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@brand.Name</div>
                                <div class="small text-muted font-monospace">@brand.Slug</div>
                            </div>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Catalog" asp-action="Index" asp-route-brand="@brand.Slug">Products</a>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#@editId" aria-expanded="false" aria-controls="@editId">Edit</button>
                            <form asp-action="Delete" asp-route-id="@brand.Id" asp-route-page="@brands.Page" method="post" data-confirm="Delete @brand.Name? Only brands without products can be deleted.">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                        <div class="collapse" id="@editId">
                            <form asp-action="Edit" asp-route-id="@brand.Id" asp-route-page="@brands.Page" method="post" class="row g-2 align-items-end pt-3">
                                <div class="col-sm-5">
                                    <label class="form-label small mb-1" for="name@(brand.Id)">Name</label>
                                    <input id="name@(brand.Id)" name="name" value="@brand.Name" class="form-control form-control-sm" maxlength="100" required />
                                </div>
                                <div class="col-sm-5">
                                    <label class="form-label small mb-1" for="logo@(brand.Id)">Logo URL</label>
                                    <input id="logo@(brand.Id)" name="logoUrl" type="url" value="@brand.LogoUrl" class="form-control form-control-sm" maxlength="500" />
                                </div>
                                <div class="col-sm-2">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <partial name="_Pager" model="@PagerViewModel.Create(brands.Page, brands.TotalPages, "Index")" />
            </div>
        }
    </div>
</div>
