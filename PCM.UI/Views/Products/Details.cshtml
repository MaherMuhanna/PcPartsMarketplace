@model ProductDetailsDto
@{
    ViewData["Title"] = Model.Name;
    var catalogPath = Url.Action("Index", "Catalog")!;
    IReadOnlyList<ProductImageDto> images = Model.Images.Count > 0 ? Model.Images : [new ProductImageDto(DisplayExtensions.PlaceholderImage, Model.Name, 0)];
    var cheapest = Model.Offers.Where(o => o.Available > 0).OrderBy(o => o.Price).FirstOrDefault();

    // Approved sellers get a shortcut to offer this product (the API re-checks approval).
    var canSell = User.IsInRole(Roles.Seller) && User.FindFirstValue(AppClaimTypes.SellerStatus) == "Approved";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a href="@catalogPath">Catalog</a></li>
        @foreach (var crumb in Model.CategoryPath)
        {
            <li class="breadcrumb-item"><a href="@CatalogQuery.Empty.With("category", crumb.Slug).ToUrl(catalogPath)">@crumb.Name</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="row g-4 mb-4">
    @* ---------------- Images ---------------- *@
    <div class="col-md-5">
        <div id="productImages" class="carousel slide border rounded-3 bg-white product-gallery" data-bs-ride="false">
            <div class="carousel-inner">
                @for (var i = 0; i < images.Count; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@images[i].Url" class="d-block w-100" alt="@(images[i].AltText ?? Model.Name)" />
                    </div>
                }
            </div>
            @if (images.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#productImages" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous image</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#productImages" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next image</span>
                </button>
            }
        </div>
    </div>

    @* ---------------- Summary ---------------- *@
    <div class="col-md-7">
        <a class="small text-decoration-none" href="@CatalogQuery.Empty.With("brand", Model.Brand.Slug).ToUrl(catalogPath)">@Model.Brand.Name</a>
        <h1 class="h3 mt-1">@Model.Name</h1>
        <div class="text-muted small mb-3">Model number: <span class="font-monospace">@Model.ModelNumber</span></div>

        @if (cheapest is not null)
        {
            <div class="fs-4 fw-semibold">From @cheapest.Price.ToPrice()</div>
            <div class="text-success small mb-3">In stock at @Model.Offers.Count(o => o.Available > 0) seller(s)</div>
        }
        else if (Model.Offers.Count > 0)
        {
            <div class="text-danger mb-3">Out of stock at every seller</div>
        }
        else
        {
            <div class="alert alert-light border mb-3">No seller offers this product yet.</div>
        }

        @if (canSell)
        {
            <a class="btn btn-outline-primary btn-sm mb-3" asp-controller="SellerOffers" asp-action="Create" asp-route-productId="@Model.Id">Sell this</a>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }

        @* Key specs at a glance: the first few attributes of the category. *@
        @if (Model.Specs.Count > 0)
        {
            <ul class="list-inline mb-0">
                @foreach (var spec in Model.Specs.Take(4))
                {
                    <li class="list-inline-item badge text-bg-light border fw-normal mb-1">@spec.Name: <strong>@spec.DisplayValue</strong></li>
                }
            </ul>
        }
    </div>
</div>

<div class="row g-4">
    @* ---------------- Offers ---------------- *@
    <section class="col-lg-7">
        <h2 class="h5">Offers</h2>
        @if (Model.Offers.Count == 0)
        {
            <p class="text-muted">Sellers can start offering this product soon.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th>Seller</th><th>Condition</th><th>Availability</th><th class="text-end">Price</th></tr>
                    </thead>
                    <tbody>
                        @* Already sorted by the API: cheapest first. *@
                        @foreach (var offer in Model.Offers)
                        {
                            <tr>
                                <td>@offer.StoreName</td>
                                <td><span class="badge @(offer.Condition == "New" ? "text-bg-primary" : "text-bg-secondary")">@offer.Condition</span></td>
                                <td class="small">@(offer.Available > 0 ? $"{offer.Available} available" : "Out of stock")</td>
                                <td class="text-end fw-semibold">@offer.Price.ToPrice()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ---------------- Specifications ---------------- *@
    <section class="col-lg-5">
        <h2 class="h5">Specifications</h2>
        @if (Model.Specs.Count == 0)
        {
            <p class="text-muted">No specifications listed.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <tbody>
                    <tr><th scope="row" class="w-50">Brand</th><td>@Model.Brand.Name</td></tr>
                    @foreach (var spec in Model.Specs)
                    {
                        <tr><th scope="row" class="w-50">@spec.Name</th><td>@spec.DisplayValue</td></tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>
